{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "ZCode Hub",
  "version": "1.4.1",
  "identifier": "com.zcode-hub.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "ZCode Hub",
        "width": 640,
        "height": 850,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1M0Y4NDBENDI3M0E5QzUKUldURnFYTkNEWVEvVmF6SlNIbDFYNlRNeDduVTVwWmRZZk1xYW5MVzVYK3RZMEpyUjVoYU0wbXkK",
      "endpoints": [
        "https://github.com/Ebonyhtx/zcode-hub/releases/latest/download/latest.json"
      ]
    }
  }
}